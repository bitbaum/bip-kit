{
  "name": "@bitbaum/bip-kit",
  "version": "0.6.1",
  "description": "Building in Public, as a content contract: parse markdown into typed blocks and render them with a reference React renderer (@bitbaum/bip-kit/react) \u2014 blog, roadmap, changelog on your product site, bring your own design tokens.",
  "license": "MIT",
  "author": "Mao Nakamoto",
  "homepage": "https://github.com/bitbaum/bip-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitbaum/bip-kit.git"
  },
  "bugs": {
    "url": "https://github.com/bitbaum/bip-kit/issues"
  },
  "keywords": [
    "build-in-public",
    "blog",
    "roadmap",
    "changelog",
    "markdown",
    "headless",
    "content",
    "nextjs",
    "react",
    "rsc",
    "renderer"
  ],
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/mermaid": {
      "types": "./dist/react/mermaid.d.ts",
      "default": "./dist/react/mermaid.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test",
    "prepare": "pnpm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "katex": "^0.19.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "shiki": ">=1",
    "mermaid": ">=10",
    "katex": ">=0.16"
  },
  "peerDependenciesMeta": {
    "shiki": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "katex": {
      "optional": true
    }
  }
}
